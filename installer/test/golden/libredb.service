[Unit]
Description=LibreDB (Docker Compose project libredb)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/libredb
ExecStart=/usr/bin/docker compose -p libredb -f /opt/libredb/compose.yaml up -d
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
