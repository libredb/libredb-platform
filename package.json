{
  "name": "libredb-platform",
  "version": "1.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "docker compose -f docker-compose.test.yml up -d --wait --force-recreate postgres && vitest run -c vitest.db.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:self-hosted": "node --env-file=e2e/self-hosted/platform.env node_modules/@playwright/test/cli.js test --project=self-hosted",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migration": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-new-migration.ts",
    "db:migrate": "prisma migrate deploy",
    "db:shadow-reset": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/prisma-shadow-reset.ts",
    "db:drift": "npm run --silent db:shadow-reset && prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:reset": "node scripts/dev/db-reset.mjs",
    "maintain": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/maintain.ts",
    "build:migrator": "esbuild seed=prisma/seeds/run.ts maintain=scripts/maintain.ts --bundle --platform=node --format=cjs --target=node24 --out-extension:.js=.cjs --outdir=docker/migrator/dist --external:@prisma/client --external:@prisma/adapter-pg --external:pg --external:bcryptjs --external:./development --log-level=warning"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@swc/helpers": "^0.5.21",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "html-react-parser": "^6.0.1",
    "isomorphic-dompurify": "^3.9.0",
    "jose": "^6.2.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.7.0",
    "nanoid": "^5.1.16",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-hotkeys-hook": "^5.2.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tippy.js": "^6.3.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^20.8.9",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
