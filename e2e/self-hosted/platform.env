# The environment of the self-hosted Platform server and of the Playwright run of the self-hosted project.
# It points at the fixture services of docker-compose.test.yml on their default ports: postgres on 55432 and
# keycloak on 58080, with the realm tests/fixtures/keycloak/libredb-test-realm.json, whose libredb-platform client
# redirects to http://localhost:3100; for another AUTH_URL, e2e/self-hosted/keycloak.setup.ts registers that
# Platform's redirect URIs on the client before the specs run.
# A variable already set in the environment wins when it is loaded with `node --env-file`, so a local run can move
# the ports; the secrets below are fixture values and never valid outside tests.
# The run also needs PLATFORM_LICENSE, which this file never holds: a license whose hosts include localhost, with
# 1 admin seat and 3 user seats. Set it in the environment of the server and of the Playwright run; CI writes it from
# the repository secret LIBREDB_E2E_LICENSE to a file and passes it to those two steps alone.
DEPLOYMENT_MODE=self-hosted
# The runtime role, pg syntax.
DATABASE_URL=postgresql://libredb_platform:libredb_platform_dev@localhost:55432/libredb?schema=platform
# The owner role for `prisma migrate deploy`, Prisma syntax.
MIGRATE_DATABASE_URL=postgresql://libredb_owner:libredb_owner_dev@localhost:55432/libredb?schema=platform
PLATFORM_ORGANIZATION_NAME=LibreDB-E2E
AUTH_SECRET=self-hosted-e2e-auth-secret-not-for-production-use
AUTH_URL=http://localhost:3100
AUTH_KEYCLOAK_ISSUER=http://localhost:58080/realms/libredb
AUTH_KEYCLOAK_ID=libredb-platform
AUTH_KEYCLOAK_SECRET=libredb-platform-test-secret
STUDIO_PUBLIC_URL=http://localhost:3200
# Studio's seal public key, without which the server stops at start: the development key that
# scripts/dev/gen-seal-keypair.mjs prints, whose private key is published.
BRIDGE_SEAL_PUBLIC_KEY=WULR-dfqAG93r5aNvR9xqMm_AkNbdbimJmSD1YzobyY
LOG_FORMAT=json
# Rechecks a Keycloak session against the directory 2 s after the last attempt instead of 300 s, so that
# e2e/self-hosted/session-recheck.spec.ts sees a removed role or an ended Keycloak session within seconds.
PLATFORM_SESSION_RECHECK_SECONDS=2
